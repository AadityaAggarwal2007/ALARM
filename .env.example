# Generate with: npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: where alarms.json lives (defaults to ./data)
# ALARM_DATA_DIR=/var/lib/alarm-app

# Login password for the app
ALARM_PASSWORD=

# Optional: how often a vibrate-only alarm re-buzzes, in ms (default 2000)
# ALARM_BUZZ_INTERVAL_MS=2000
