# Generate with: npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: where alarms.json lives (defaults to ./data)
# ALARM_DATA_DIR=/var/lib/alarm-app

# Login password for the app
ALARM_PASSWORD=

# Optional: how often a ringing alarm re-buzzes, in ms (default 1000).
# Raise it if Apple starts throttling the pushes.
# ALARM_BUZZ_INTERVAL_MS=1000
